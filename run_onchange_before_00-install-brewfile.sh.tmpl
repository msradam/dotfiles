#!/bin/bash
# {{ include "Brewfile" | sha256sum }}
set -euo pipefail

if ! command -v brew &>/dev/null; then
    echo "[skip] brew not found"
    exit 0
fi

grep -E '^tap "' "{{ .chezmoi.sourceDir }}/Brewfile" \
    | sed -E 's/^tap "([^"]+)".*/\1/' \
    | while read -r t; do brew trust "$t" &>/dev/null || true; done

brew bundle install --file="{{ .chezmoi.sourceDir }}/Brewfile" --no-upgrade || true
