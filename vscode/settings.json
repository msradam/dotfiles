{
    // ── Theme ───────────────────────────────────────────────────────
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.preferredDarkColorTheme": "Catppuccin Mocha",
    "workbench.preferredLightColorTheme": "Catppuccin Frappé",
    "window.autoDetectColorScheme": true,
    "workbench.iconTheme": "catppuccin-mocha",
    "catppuccin.accentColor": "lavender",
    // ── Minimal Chrome ──────────────────────────────────────────────
    "window.titleBarStyle": "native",
    "window.commandCenter": true,
    "workbench.activityBar.location": "top",
    "workbench.layoutControl.enabled": false,
    "workbench.startupEditor": "none",
    "editor.minimap.enabled": false,
    "editor.renderLineHighlight": "gutter",
    "breadcrumbs.enabled": true,
    // ── Font ────────────────────────────────────────────────────────
    "editor.fontFamily": "'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": true,
    "editor.fontWeight": "400",
    "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.lineHeight": 1.3,
    // ── Editor ──────────────────────────────────────────────────────
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.linkedEditing": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.wordWrap": "on",
    "editor.stickyScroll.enabled": true,
    "editor.inlayHints.enabled": "onUnlessPressed",
    "editor.suggest.insertMode": "replace",
    // ── Files ───────────────────────────────────────────────────────
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    // ── Terminal ────────────────────────────────────────────────────
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.minimumContrastRatio": 1,
    // ── Workbench ───────────────────────────────────────────────────
    "workbench.list.smoothScrolling": true,
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.editor.enablePreview": false,
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.sortOrder": "type",
    // ── Git ─────────────────────────────────────────────────────────
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "diffEditor.ignoreTrimWhitespace": false,
    // ── Notebook ────────────────────────────────────────────────────
    "notebook.lineNumbers": "on",
    // ── Copilot ─────────────────────────────────────────────────────
    "github.copilot.nextEditSuggestions.enabled": true,
    // ── Claude Code ─────────────────────────────────────────────────
    "claudeCode.preferredLocation": "panel",
    "claudeCode.selectedModel": "claude-opus-4-6",
    // ── Security ────────────────────────────────────────────────────
    "security.workspace.trust.untrustedFiles": "open",
    // ── Marp ────────────────────────────────────────────────────────
    "markdown.marp.themes": [
        "https://rainbowflesh.github.io/css/rose-pine-dawn.css",
        "https://rainbowflesh.github.io/css/rose-pine-moon.css",
        "https://rainbowflesh.github.io/css/rose-pine.css"
    ],
    "markdown.marp.html": true,
    // ── STM32/Embedded ──────────────────────────────────────────────
    "cmake.environment": {
        "PATH": "/Users/amsrahman/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.2.0-darwin-arm64/resources/binaries/darwin/aarch64:/Users/amsrahman/.vscode/extensions/stmicroelectronics.stm32cube-ide-build-cmake-1.44.0-darwin-arm64/resources/cube-cmake/darwin/aarch64:${env.PATH}"
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "debug.allowBreakpointsEverywhere": true,
    "claudeCode.allowDangerouslySkipPermissions": true
}
