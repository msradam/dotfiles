// Forward Escape and Alt/Option+Enter to the focused integrated terminal
// so TUIs (Claude Code, vim) receive them instead of VS Code eating them.
[
  {
    "key": "escape",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b"
    },
    "when": "terminalFocus && !terminalFindVisible"
  },
  {
    "key": "alt+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b\r"
    },
    "when": "terminalFocus"
  }
]
