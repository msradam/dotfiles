{{- $uvArch := "aarch64" -}}
{{- if eq .chezmoi.arch "amd64" }}{{ $uvArch = "x86_64" }}{{ end -}}
{
  // ── Telemetry / noise off ───────────────────────────────────────
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,
  "update.showReleaseNotes": false,

  // ── Theme (auto light/dark by macOS appearance) ─────────────────
  // Mirrors the system-wide Catppuccin Latte/Mocha auto-switch used by
  // Ghostty, the shell, and Neovim. autoDetectColorScheme follows the OS
  // appearance; the two preferred* keys choose the variant per mode.
  "window.autoDetectColorScheme": true,
  // UI chrome scale. Multiplies onto editor/terminal font sizes below, so
  // those are set lower than Ghostty's codeFontSize to keep the three areas
  // in a sane hierarchy (UI ~16, terminal ~16, editor ~17 effective).
  "window.zoomLevel": 1,
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.preferredDarkColorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 12,
  "workbench.list.smoothScrolling": true,
  "workbench.editor.enablePreview": false,

  // ── Fonts ───────────────────────────────────────────────────────
  "editor.fontFamily": "'Input Mono', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.5,

  // ── Editor behavior ─────────────────────────────────────────────
  // Rulers at 88 (ruff/black line length) and 100 (hard ceiling).
  "editor.rulers": [88, 100],
  "editor.stickyScroll.enabled": true,
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "solid",
  "editor.linkedEditing": true,
  "editor.renderWhitespace": "boundary",
  "editor.tabSize": 2,
  // format-on-save runs the language formatter below. If a Claude Code
  // edit and the formatter ever fight over a file, set this to false and
  // format via the toolchain / pre-commit instead.
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",

  // ── Files ───────────────────────────────────────────────────────
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/dist": true
  },
  "search.followSymlinks": false,
  "search.useIgnoreFiles": true,

  // ── Explorer quality-of-life ────────────────────────────────────
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // ── Terminal ────────────────────────────────────────────────────
  "terminal.integrated.fontFamily": "'Input Mono', 'Symbols Nerd Font Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.gpuAcceleration": "on",

  // ── Python (uv-managed interpreter) ─────────────────────────────
  "python.defaultInterpreterPath": "{{ env "HOME" }}/.local/share/uv/python/cpython-3.12-macos-{{ $uvArch }}-none/bin/python3.12",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },

  // ── Git ─────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,

  // ── Claude Code (VS Code extension) ─────────────────────────────
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.allowDangerouslySkipPermissions": true
}
