# Ghostty — primary terminal config.
# Reference: https://ghostty.org/docs/config/reference

# ── Theme ─────────────────────────────────────────────────────────
# Auto-switch with macOS appearance.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
window-theme = auto

# ── Font ──────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font Mono
font-size = 13
font-thicken = true
adjust-cell-height = 10%

# ── Window ────────────────────────────────────────────────────────
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-decoration = true
window-save-state = always
window-inherit-working-directory = true
window-inherit-font-size = true
window-new-tab-position = end
window-colorspace = display-p3
background-opacity = 0.97
unfocused-split-opacity = 0.85
macos-titlebar-style = tabs
macos-option-as-alt = true
macos-non-native-fullscreen = visible-menu

# ── Cursor ────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true

# ── Clipboard ─────────────────────────────────────────────────────
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# ── Shell integration ─────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ── Scrollback / behavior ─────────────────────────────────────────
scrollback-limit = 25000000
mouse-scroll-multiplier = 1.5
resize-overlay = after-first
confirm-close-surface = false
quit-after-last-window-closed = true
auto-update = check

# ── Bell ──────────────────────────────────────────────────────────
bell-features = no-audio,no-attention

# ── Keybinds ──────────────────────────────────────────────────────
# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+ctrl+left=resize_split:left,40
keybind = cmd+ctrl+right=resize_split:right,40
keybind = cmd+ctrl+up=resize_split:up,40
keybind = cmd+ctrl+down=resize_split:down,40
keybind = cmd+enter=toggle_split_zoom

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+shift+[=previous_tab

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Quick reset
keybind = cmd+k=clear_screen
